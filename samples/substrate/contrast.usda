    def Xform "Dry_0" (
        prepend references = @../wet_surface/asset.usda@
    )
    {
        double3 xformOp:translate = (-135, 0, 60)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Sphere" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/WaterCoating>
            float[] primvars:wetness = [0] (
                interpolation = "constant"
            )
        }
    }

    def Xform "Coated_1" (
        prepend references = @../wet_surface/asset.usda@
