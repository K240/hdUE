{
    float2 clippingRange = (1, 5000)
    float focalLength = 50
    float horizontalAperture = 36
    float verticalAperture = 20.25
    matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.18237319193896595, 0.9832293826274687, 0), (0, -0.9832293826274686, 0.18237319193896592, 0), (0, -620, 174.99999999999997, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}

