            float inputs:exposure = -2
            asset inputs:texture:file = @environment.hdr@
            token inputs:texture:format = "latlong"
            float xformOp:rotateY = 0
            uniform token[] xformOpOrder = ["xformOp:rotateY"]
        }

        def SphereLight "Point00"
        {
            color3f inputs:color = (1, 0.25, 0.1)
            float inputs:intensity = 50
            float inputs:radius = 0.08
            double3 xformOp:translate = (2, 1.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

