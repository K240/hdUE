        def RectLight "Rect"
        {
            float inputs:height = 1.2
            float inputs:intensity = 20
            asset inputs:texture:file = @emitter.hdr@
            float inputs:width = 0.8
            matrix4d xformOp:transform = ( (0.447213595499958, 0, 0.894427190999916, -0), (0.5962847939999439, 0.7453559924999299, -0.29814239699997197, 0), (-0.6666666666666666, 0.6666666666666666, 0.3333333333333333, 0), (-2, 2.5, 1, 0.9999999999999999) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def DiskLight "Disk"
        {
            float inputs:intensity = 8
