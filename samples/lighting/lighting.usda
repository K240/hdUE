            matrix4d xformOp:transform = ( (-0.7071067811865475, 0, -0.7071067811865475, 0), (-0.6154574548966636, 0.4923659639173309, 0.6154574548966636, -0), (0.3481553119113957, 0.8703882797784891, -0.3481553119113957, 0), (0.9999999999999998, 2.999999999999999, -0.9999999999999998, 1) )
