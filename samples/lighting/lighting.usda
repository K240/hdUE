def Camera "Camera"
{
    float2 clippingRange = (0.01, 1000)
    float focalLength = 40
    float horizontalAperture = 36
    float verticalAperture = 24
    matrix4d xformOp:transform = ( (0.7999999999999999, 0, -0.5999999999999999, 0), (-0.1931416399432214, 0.9467727448197127, -0.2575221865909619, 0), (0.5680636468918278, 0.3219027332387024, 0.7574181958557703, -0), (3.0000000000000004, 2.4000000000000004, 4.000000000000001, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}
