        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalmap_float"
            vector3f inputs:in.connect = </Looks/Flat_Normal/Image.outputs:out>
            float inputs:scale = 0.7
            vector3f outputs:out
        }
    }

    def Material "UDIM_Swap"
    {
        token outputs:mtlx:surface.connect = </Looks/UDIM_Swap/Surface.outputs:out>
        token outputs:surface.connect = </Looks/UDIM_Swap/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
