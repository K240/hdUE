                colorSpace = "raw"
            )
            float2 inputs:texcoord.connect = </Looks/Flat_Normal/UV.outputs:out>
            vector3f outputs:out
        }

        def Shader "UV"
        {
            uniform token info:id = "ND_texcoord_vector2"
