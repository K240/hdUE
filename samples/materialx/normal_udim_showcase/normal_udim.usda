        }

        def Shader "Surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            color3f inputs:base_color = (0.5, 0.5, 0.5)
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/UDIM_Swap/Image.outputs:out>
