<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <open_pbr_surface name="OP_Metal_surface" type="surfaceshader">
    <input name="base_weight" type="float" value="0.9" />
    <input name="base_color" type="color3" value="0.7, 0.27, 0.07" />
    <input name="base_metalness" type="float" value="0.95" />
    <input name="specular_roughness" type="float" value="0.32" />
  </open_pbr_surface>
  <surfacematerial name="OP_Metal" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="OP_Metal_surface" />
  </surfacematerial>
  <open_pbr_surface name="OP_Coat_surface" type="surfaceshader">
    <input name="base_weight" type="float" value="0.9" />
    <input name="base_color" type="color3" nodename="OP_checker" />
    <input name="base_metalness" type="float" value="0.02" />
    <input name="specular_roughness" type="float" value="0.32" />
    <input name="coat_weight" type="float" value="0.9" />
    <input name="coat_roughness" type="float" value="0.07" />
  </open_pbr_surface>
  <image name="OP_checker" type="color3">
    <input name="file" type="filename" value="textures/cool.png" colorspace="srgb_texture" />
  </image>
  <surfacematerial name="OP_Coat" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="OP_Coat_surface" />
  </surfacematerial>
  <open_pbr_surface name="OP_Anisotropy_surface" type="surfaceshader">
    <input name="base_weight" type="float" value="0.9" />
    <input name="base_color" type="color3" value="0.7, 0.27, 0.07" />
    <input name="base_metalness" type="float" value="0.95" />
    <input name="specular_roughness" type="float" value="0.32" />
    <input name="specular_roughness_anisotropy" type="float" value="0.8" />
  </open_pbr_surface>
  <surfacematerial name="OP_Anisotropy" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="OP_Anisotropy_surface" />
  </surfacematerial>
  <open_pbr_surface name="OP_Glass_surface" type="surfaceshader">
    <input name="base_weight" type="float" value="0.9" />
    <input name="base_color" type="color3" value="0.35, 0.08, 0.04" />
    <input name="base_metalness" type="float" value="0.02" />
    <input name="specular_roughness" type="float" value="0.07" />
    <input name="transmission_weight" type="float" value="0.98" />
    <input name="transmission_color" type="color3" value="0.45, 0.8, 0.95" />
    <input name="transmission_depth" type="float" value="20" />
    <input name="specular_ior" type="float" value="1.45" />
  </open_pbr_surface>
  <surfacematerial name="OP_Glass" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="OP_Glass_surface" />
  </surfacematerial>
  <open_pbr_surface name="OP_Subsurface_surface" type="surfaceshader">
    <input name="base_weight" type="float" value="0.9" />
    <input name="base_color" type="color3" value="0.35, 0.08, 0.04" />
    <input name="base_metalness" type="float" value="0.02" />
    <input name="specular_roughness" type="float" value="0.32" />
    <input name="subsurface_weight" type="float" value="0.85" />
    <input name="subsurface_color" type="color3" value="0.85, 0.25, 0.08" />
    <input name="subsurface_radius" type="float" value="3.0" />
  </open_pbr_surface>
  <surfacematerial name="OP_Subsurface" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="OP_Subsurface_surface" />
  </surfacematerial>
</materialx>